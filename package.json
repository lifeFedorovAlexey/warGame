{
  "name": "wargame",
  "version": "0.1.0",
  "private": true,
  "description": "Modular vehicle game assets and local review arena",
  "scripts": {
    "check:assets": "python tools/reference_pack.py --check",
    "check:demo": "node tools/demo-smoke.cjs",
    "export:models": "node tools/export-production.cjs",
    "check:models": "node tools/validate-production.cjs",
    "check:terrain": "node tools/terrain-smoke.cjs",
    "check:driving": "node tools/drive-smoke.cjs",
    "check:map": "node tools/check-alpha-map.cjs",
    "check:roads": "node tools/check-road-tour.cjs",
    "check:cinematics": "node tools/check-cinematics.cjs",
    "check:builder": "node tools/check-builder.cjs",
    "check:mission": "node tools/check-mission.mjs --full",
    "check:combat-policy": "node tools/check-combat-policy.mjs",
    "check:combat-menu": "node tools/check-combat-menu.mjs",
    "check:combat-deployment": "node tools/check-combat-deployment.mjs",
    "check:combat-reserves": "node tools/check-combat-reserves.mjs",
    "check:combat-headway": "node tools/check-combat-headway.mjs",
    "check:mountain-routing": "node tools/check-mountain-routing.mjs",
    "check:contact-rock": "node tools/check-contact-rock.mjs",
    "check:dead-unit-clearance": "node tools/check-dead-unit-clearance.mjs",
    "check:contact-rock:browser": "node tools/check-contact-rock-browser.mjs",
    "check:combat-flow": "node tools/check-combat-flow.mjs --budget && node tools/check-combat-flow-terrain.mjs",
    "check:damage": "node tools/check-damage.mjs && node tools/check-damage-surface.mjs",
    "check:salvage": "node tools/check-salvage.mjs",
    "check:pickup": "node tools/check-pickup-orders.mjs",
    "check:traffic": "node tools/check-traffic-coordinator.mjs",
    "check:destruction": "node tools/check-wreck-lifecycle.mjs",
    "check:simulation-budget": "node tools/check-unit-spatial.mjs && node tools/check-simulation-budget.mjs && node tools/check-fog-optimization.mjs",
    "bench:500": "node tools/check-damage-browser.mjs --benchmark --budget",
    "check:damage:browser": "node tools/check-damage-browser.mjs",
    "bench:damage": "node tools/check-damage-browser.mjs --benchmark",
    "check:campaign": "node tools/check-campaign.cjs",
    "check:story": "node tools/check-story-v2.mjs && node tools/check-radio-save.mjs",
    "check:story:browser": "node tools/check-story-v2-browser.mjs",
    "export:buildings": "node tools/export-buildings.cjs",
    "export:cinematics": "python tools/export-cinematics.py --chapter all",
    "check:film": "node tools/check-film.cjs",
    "build:campaign-content": "python tools/build-mission-content.py",
    "build:campaign-audio": "python tools/build-campaign-audio.py",
    "build:story-audio": "python tools/build-mission-v2-audio.py",
    "build:map": "python tools/build-alpha-map.py",
    "build:map-textures": "node tools/build-alpha-texture.cjs",
    "build:roads": "node tools/build-roads.cjs"
  },
  "devDependencies": {
    "gltf-validator": "^2.0.0-dev.3.10"
  },
  "type": "module"
}
