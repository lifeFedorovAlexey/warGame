  "dialogue": [
    {
      "id": "m02-radio-start-1",
      "speaker": "radio",
      "text": "Альфа, источник сигнала к югу. Координаты передаю.",
      "pauseAfter": 0.2,
      "recordingStatus": "Т",
      "clip": null
    },
    {
      "id": "m02-radio-start-2",
      "speaker": "commander",
      "text": "Базу прикрыть. Основной группе — на выезд.",
      "pauseAfter": 0.2,
      "recordingStatus": "Т",
      "clip": null
    },
    {
      "id": "m02-radio-entrance-1",
      "speaker": "scout",
      "text": "Проход перекрыт. Впереди два ДОТа.",
      "pauseAfter": 0.2,
      "recordingStatus": "Т",
      "clip": null
    },
    {
      "id": "m02-radio-entrance-2",
      "speaker": "commander",
      "text": "Вижу. Сначала убираем укрепления.",
      "pauseAfter": 0.2,
      "recordingStatus": "Т",
      "clip": null
    },
    {
      "id": "m02-radio-entrance-changed-1",
      "speaker": "scout",
      "text": "Укрепления в проходе подавлены частично. Проверяем дорогу.",
      "pauseAfter": 0.2,
      "recordingStatus": "Т",
      "clip": null
    },
    {
      "id": "m02-radio-entrance-clear-1",
      "speaker": "scout",
      "text": "ДОТы в проходе уничтожены. Дорога на юг открыта.",
      "pauseAfter": 0.2,
      "recordingStatus": "Т",
      "clip": null
    },
    {
      "id": "m02-radio-factory-working-1",
      "speaker": "scout",
      "text": "У них завод работает. Машины прямо из ворот идут.",
      "pauseAfter": 0.2,
      "recordingStatus": "Т",
      "clip": null
    },
    {
      "id": "m02-radio-factory-working-2",
      "speaker": "commander",
      "text": "Тогда начнём с завода.",
      "pauseAfter": 0.2,
      "recordingStatus": "Т",
      "clip": null
    },
    {
      "id": "m02-radio-factory-destroyed-1",
      "speaker": "scout",
      "text": "Завод уничтожен.",
      "pauseAfter": 0.2,
      "recordingStatus": "Т",
      "clip": null
    },
    {
      "id": "m02-radio-factory-destroyed-2",
      "speaker": "commander",
      "text": "Принято. Осмотрите площадку.",
      "pauseAfter": 0.2,
      "recordingStatus": "Т",
      "clip": null
    },
    {
      "id": "m02-radio-flamer-ready-1",
      "speaker": "scientist",
      "text": "Огнемёты доработали. Теперь мощнее.",
      "pauseAfter": 0.2,
      "recordingStatus": "Т",
      "clip": null
    },
    {
      "id": "m02-radio-twin-ready-1",
      "speaker": "scientist",
      "text": "Спаренный пулемёт готов. Можно ставить в конструкторе.",
      "pauseAfter": 0.2,
      "recordingStatus": "Т",
      "clip": null
    },
    {
      "id": "m02-radio-sensor-ready-1",
      "speaker": "scientist",
      "text": "Сенсор готов. Ставится вместо оружия, видит дальше.",
      "pauseAfter": 0.2,
      "recordingStatus": "Т",
      "clip": null
    },
    {
      "id": "m02-radio-sensor-ready-2",
      "speaker": "warrant",
      "text": "То есть стрелять нечем?",
      "pauseAfter": 0.2,
      "recordingStatus": "Т",
      "clip": null
    },
    {
      "id": "m02-radio-sensor-ready-3",
      "speaker": "scientist",
      "text": "Зато раньше узнаете, что пора уезжать.",
      "pauseAfter": 0.2,
      "recordingStatus": "Т",
      "clip": null
    },
    {
      "id": "m02-radio-observer-seen-1",
      "speaker": "scout",
      "text": "Командир, чужая машина. На тех отбросов не похожа.",
      "pauseAfter": 0.2,
      "recordingStatus": "Т",
      "clip": null
    },
    {
      "id": "m02-radio-observer-seen-2",
      "speaker": "commander",
      "text": "Попробуйте перехватить.",
      "pauseAfter": 0.2,
      "recordingStatus": "Т",
      "clip": null
    },
    {
      "id": "m02-radio-observer-escaped-1",
      "speaker": "scout",
      "text": "Ушла из района. След потеряли.",
      "pauseAfter": 0.2,
      "recordingStatus": "Т",
      "clip": null
    },
    {
      "id": "m02-radio-observer-destroyed-1",
      "speaker": "scout",
      "text": "Разведчик уничтожен. Маркировку записали.",
      "pauseAfter": 0.2,
      "recordingStatus": "Т",
      "clip": null
    },
    {
      "id": "m02-radio-energy-source-1",
      "speaker": "scout",
      "text": "Источник нашли. Работает старый энергоузел.",
      "pauseAfter": 0.2,
      "recordingStatus": "Т",
      "clip": null
    },
    {
      "id": "m02-radio-energy-source-2",
      "speaker": "commander",
      "text": "Охрану убрать. После боя осмотреть оборудование.",
      "pauseAfter": 0.2,
      "recordingStatus": "Т",
      "clip": null
    },
    {
      "id": "m02-radio-power-recovered-1",
      "speaker": "scout",
      "text": "Энергомодуль нашли. Данные передали в НИИ.",
      "pauseAfter": 0.2,
      "recordingStatus": "Т",
      "clip": null
    },
    {
      "id": "m02-radio-victory-1",
      "speaker": "commander",
      "text": "Район зачищен. Все четыре образца у нас.",
      "pauseAfter": 0.2,
      "recordingStatus": "Т",
      "clip": null
    },
    {
      "id": "m02-radio-power-researched-1",
      "speaker": "scientist",
      "text": "Энергомодуль изучен. Теперь можно усилить нашу станцию.",
      "pauseAfter": 0.2,
      "recordingStatus": "Т",
      "clip": null
    }
  ],
