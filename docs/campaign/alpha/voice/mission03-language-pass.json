{
  "mission": "alpha-m03",
  "budgetCredits": 2000,
  "tone": "Короткий живой русский; стёб над командованием и отчётами. Боевые сведения конкретные. При потерях без победных шуток.",
  "scenes": [
    {
      "id": "m03-s01",
      "title": "Приказ на экспедицию",
      "lines": [
        {
          "speaker": "general",
          "text": "Альфа, нашли довоенный склад. Забрать оружейную технологию."
        },
        {
          "speaker": "commander",
          "text": "А хозяева склада?"
        },
        {
          "speaker": "general",
          "text": "По документам — мы. Документы оформим по возвращении.",
          "direction": "dry"
        }
      ]
    },
    {
      "id": "m03-s02",
      "title": "Знакомство с «Коровником»",
      "lines": [
        {
          "speaker": "commander",
          "text": "Это и есть наш транспорт?"
        },
        {
          "speaker": "warrant",
          "text": "Коровник. Два винта, жрёт за четверых."
        },
        {
          "speaker": "commander",
          "text": "На обратный путь хватит?"
        },
        {
          "speaker": "warrant",
          "text": "В приказе сказано вернуться. Значит, хватит.",
          "direction": "dry"
        }
      ]
    },
    {
      "id": "m03-s03",
      "title": "Начало погрузки",
      "lines": [
        {
          "speaker": "radio",
          "text": "Коровник, принимаешь машины?"
        },
        {
          "speaker": "pilot",
          "text": "Рампа открыта. По одному! Это вертолёт, не маршрутка."
        }
      ]
    },
    {
      "id": "m03-s04",
      "title": "Транспорт загружен",
      "lines": [
        {
          "speaker": "pilot",
          "text": "Машины на борту. К вылету готов."
        },
        {
          "speaker": "commander",
          "text": "Поднимай."
        }
      ]
    },
    {
      "id": "m03-s05",
      "title": "Высадка",
      "lines": [
        {
          "speaker": "pilot",
          "text": "На месте. Выгружаемся."
        },
        {
          "speaker": "scout",
          "text": "На дороге свежие следы. Тут ездят."
        },
        {
          "speaker": "commander",
          "text": "Держаться вместе. Осмотреться."
        }
      ]
    },
    {
      "id": "m03-s06",
      "title": "Первый контакт",
      "lines": [
        {
          "speaker": "scout",
          "text": "Патруль на дороге. Несколько машин."
        },
        {
          "speaker": "commander",
          "text": "Обход есть?"
        },
        {
          "speaker": "scout",
          "text": "Грунтовка за высотой. Можно попробовать."
        }
      ]
    },
    {
      "id": "m03-s07",
      "title": "Обнаружен склад",
      "lines": [
        {
          "speaker": "scout",
          "text": "Склад. У ворот огнемётная башня."
        },
        {
          "speaker": "commander",
          "text": "Вот тебе и наше имущество.",
          "direction": "dry"
        }
      ]
    },
    {
      "id": "m03-s08",
      "title": "Технология найдена",
      "lines": [
        {
          "speaker": "scout",
          "text": "Тяжёлый пулемёт. Довоенный. Чертежи целы."
        },
        {
          "speaker": "commander",
          "text": "Забирай. Теперь у нас тоже будут аргументы.",
          "direction": "dry"
        }
      ]
    },
    {
      "id": "m03-s09",
      "title": "Странная находка",
      "lines": [
        {
          "speaker": "scout",
          "text": "Тут уже поработали. Оборудование сняли недавно. Чисто, без лома."
        },
        {
          "speaker": "commander",
          "text": "Место отметь. И поглядывай по сторонам."
        }
      ]
    },
    {
      "id": "m03-s10",
      "title": "Вызов эвакуации",
      "lines": [
        {
          "speaker": "commander",
          "text": "Коровник, мы у площадки. Забирай."
        },
        {
          "speaker": "pilot",
          "text": "Захожу. Только без давки на рампе."
        }
      ]
    },
    {
      "id": "m03-s11",
      "title": "Возвращение",
      "lines": [
        {
          "speaker": "radio",
          "text": "Коровник на базе. Наши вернулись."
        },
        {
          "speaker": "commander",
          "text": "Находку — в НИИ. Машины осмотреть. Людям отдых."
        }
      ]
    },
    {
      "id": "m03-s12",
      "title": "Итог исследования",
      "lines": [
        {
          "speaker": "scientist",
          "text": "Пулемёт готов к производству. По довоенным чертежам."
        },
        {
          "speaker": "general",
          "text": "Запишите: разработан под моим руководством.",
          "direction": "dry"
        },
        {
          "speaker": "commander",
          "text": "До войны?"
        },
        {
          "speaker": "general",
          "text": "Тем более. Сколько лет работы.",
          "direction": "dry"
        }
      ]
    },
    {
      "id": "m03-five-minutes",
      "title": "Осталось пять минут",
      "lines": [
        {
          "speaker": "pilot",
          "text": "Альфа, осталось пять минут. Не забудьте время на погрузку."
        }
      ]
    },
    {
      "id": "m03-one-minute",
      "title": "Осталась минута",
      "lines": [
        {
          "speaker": "pilot",
          "text": "Альфа, осталась минута! Всем к точке эвакуации!",
          "direction": "urgent"
        }
      ]
    },
    {
      "id": "m03-s07-clear",
      "title": "Склад без охраны",
      "lines": [
        {
          "speaker": "scout",
          "text": "Склад перед нами. Подступы чистые. Проверим, что уцелело."
        }
      ]
    },
    {
      "id": "m03-s12-losses",
      "title": "Исследование после потерь",
      "lines": [
        {
          "speaker": "scientist",
          "text": "Пулемёт готов к производству. По довоенным чертежам."
        },
        {
          "speaker": "commander",
          "text": "Жаль, не все вернулись.",
          "direction": "somber"
        }
      ]
    }
  ]
}
